parser NseixDropcopyServerParser(packet_in packet, out headers_t hdr, inout metadata_t meta, inout standard_metadata_t standard_metadata) {
    state start {
        packet.extract(hdr.message_header);
        transition select(hdr.message_header.transaction_code) {
            16w2301: parse_sign_on_out_message;
            16w2222: parse_trade_confirmation_message;
            16w2287: parse_trade_modify_confirm_message;
            16w2288: parse_trade_modify_reject_message;
            16w2282: parse_trade_cancel_confirm_message;
            16w2286: parse_trade_cancel_reject_message;
            16w2090: parse_nlt_trade_confirmation_message;
            16w5449: parse_nlt_trd_mod_confirmation_message;
            16w5450: parse_nlt_trd_mod_reject_message;
            16w5452: parse_nlt_trd_cxl_confirmation_message;
