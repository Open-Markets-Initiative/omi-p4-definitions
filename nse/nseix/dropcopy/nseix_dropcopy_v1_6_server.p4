control NseixDropcopyServerVerifyChecksum(inout headers_t hdr, inout metadata_t meta) {
    apply {
    }
}

control NseixDropcopyServerIngress(inout headers_t hdr, inout metadata_t meta, inout standard_metadata_t standard_metadata) {
    apply {
        if (meta.dispatched == 1) {
            standard_metadata.egress_spec = FORWARD_PORT;
        }
        else {
            mark_to_drop(standard_metadata);
        }
    }
}

control NseixDropcopyServerEgress(inout headers_t hdr, inout metadata_t meta, inout standard_metadata_t standard_metadata) {
    apply {
    }
}

control NseixDropcopyServerComputeChecksum(inout headers_t hdr, inout metadata_t meta) {
    apply {
    }
}

control NseixDropcopyServerDeparser(packet_out packet, in headers_t hdr) {
    apply {
        packet.emit(hdr.message_header);
        packet.emit(hdr.sign_on_out_message);
        packet.emit(hdr.trade_confirmation_message);
        packet.emit(hdr.trade_modify_confirm_message);
        packet.emit(hdr.trade_modify_reject_message);
        packet.emit(hdr.trade_cancel_confirm_message);
        packet.emit(hdr.trade_cancel_reject_message);
        packet.emit(hdr.nlt_trade_confirmation_message);
        packet.emit(hdr.nlt_trd_mod_confirmation_message);
        packet.emit(hdr.nlt_trd_mod_reject_message);
        packet.emit(hdr.nlt_trd_cxl_confirmation_message);
        packet.emit(hdr.nlt_trd_cxl_reject_message);
        packet.emit(hdr.giveup_app_confirm_tm_message);
        packet.emit(hdr.giveup_rej_confirm_tm_message);
        packet.emit(hdr.board_lot_out_message);
        packet.emit(hdr.order_mod_out_message);
        packet.emit(hdr.order_mod_reject_message);
        packet.emit(hdr.order_cancel_out_message);
        packet.emit(hdr.order_cancel_reject_message);
        packet.emit(hdr.order_confirmation_message);
        packet.emit(hdr.order_mod_confirmation_message);
        packet.emit(hdr.order_cancel_confirmation_message);
        packet.emit(hdr.freeze_to_control_message);
        packet.emit(hdr.order_error_message);
        packet.emit(hdr.batch_order_cancel_message);
        packet.emit(hdr.net_order_error_message);
        packet.emit(hdr.nlt_confirmation_message);
        packet.emit(hdr.nlt_mod_confirmation_message);
        packet.emit(hdr.nlt_cxl_confirmation_message);
        packet.emit(hdr.nlt_mod_reject_message);
        packet.emit(hdr.nlt_cxl_reject_message);
        packet.emit(hdr.spread_order_confirmation_message);
        packet.emit(hdr.sp_order_error_message);
        packet.emit(hdr.sp_net_order_error_message);
        packet.emit(hdr.spread_cxl_confirmation_message);
        packet.emit(hdr.spread_mod_confirmation_message);
        packet.emit(hdr.spread_mod_reject_message);
        packet.emit(hdr.spread_cxl_reject_message);
        packet.emit(hdr.batch_spread_order_cancel_message);
        packet.emit(hdr.twol_order_confirmation_message);
        packet.emit(hdr.thrl_order_confirmation_message);
        packet.emit(hdr.twol_order_error_message);
        packet.emit(hdr.thrl_order_error_message);
        packet.emit(hdr.twol_net_order_error_message);
        packet.emit(hdr.thrl_net_order_error_message);
        packet.emit(hdr.twol_order_cxl_confirmation_message);
        packet.emit(hdr.thrl_order_cxl_confirmation_message);
    }
}

V1Switch(
    NseixDropcopyServerParser(),
    NseixDropcopyServerVerifyChecksum(),
    NseixDropcopyServerIngress(),
    NseixDropcopyServerEgress(),
    NseixDropcopyServerComputeChecksum(),
    NseixDropcopyServerDeparser()
) main;
