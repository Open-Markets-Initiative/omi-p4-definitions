#include <core.p4>
#include <v1model.p4>

#define MAX_MESSAGES 64
#define FORWARD_PORT 1

header message_header_t {
    bit<16> packet_length;
    bit<32> packet_sequence_number;
    bit<128> checksum;
    bit<16> transaction_code;
    bit<32> log_time;
    bit<16> alpha_char;
    bit<32> trader_id;
    bit<16> error_code;
    bit<64> header_timestamp;
    bit<64> time_stamp_1;
    bit<64> time_stamp_2;
    bit<16> message_length;
}

header sign_on_out_message_t {
    bit<32> user_id;
    bit<64> password;
    bit<64> reserved_8;
    bit<240> reserved_30;
    bit<40> broker_id;
    bit<952> reserved_119;
}

header trade_confirmation_message_t {
    bit<64> response_order_number;
    bit<40> broker_id;
    bit<8> reserved_1;
    bit<32> trader_num;
    bit<80> account_num;
    bit<16> buy_sell;
    bit<32> original_vol;
    bit<32> disclosed_vol;
    bit<32> remaining_vol;
    bit<32> disclosed_vol_remaining;
    bit<32> price;
    bit<1> ato;
    bit<1> market;
    bit<1> sl;
    bit<1> mit;
    bit<1> day;
    bit<1> gtc;
    bit<1> ioc;
    bit<1> aon;
    bit<1> mf;
    bit<1> matched_ind;
    bit<1> traded;
    bit<1> modified;
    bit<1> frozen;
    bit<1> nlt_indc;
    bit<1> preclose;
    bit<1> preopen;
    bit<32> gtd;
    bit<32> fill_number;
    bit<32> fill_qty;
    bit<32> fill_price;
    bit<32> vol_filled_today;
    bit<16> activity_type;
    bit<32> activity_time;
    bit<64> op_order_number;
    bit<40> op_broker_id;
    bit<8> second_reserved_1;
    bit<32> token;
    bit<48> instrument_name;
    bit<80> symbol;
    bit<32> expiry_date;
    bit<32> strike_price;
    bit<16> option_type;
    bit<16> ca_level;
    bit<8> open_close;
    bit<8> old_open_close;
    bit<8> trade_book_type;
    bit<8> third_reserved_1;
    bit<32> new_volume;
    bit<80> old_account_number;
    bit<96> participant;
    bit<96> old_participant;
    bit<2> additional_order_flags_reserved_78;
    bit<1> session_ind;
    bit<1> stpc;
    bit<1> additional_order_flags_reserved_4;
    bit<1> additional_order_flags_reserved_3;
    bit<1> col;
    bit<1> additional_order_flags_reserved_1;
    bit<8> fourth_reserved_1;
    bit<8> give_up_trade;
    bit<8> fifth_reserved_1;
    bit<80> reserved_10;
    bit<128> echo_back;
    bit<480> reserved_60;
}

