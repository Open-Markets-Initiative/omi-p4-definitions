            16w2042: parse_order_mod_reject_message;
            16w2071: parse_order_cancel_out_message;
            16w2072: parse_order_cancel_reject_message;
            16w2073: parse_order_confirmation_message;
            16w2074: parse_order_mod_confirmation_message;
            16w2075: parse_order_cancel_confirmation_message;
            16w2170: parse_freeze_to_control_message;
            16w2231: parse_order_error_message;
            16w9002: parse_batch_order_cancel_message;
            16w27100: parse_net_order_error_message;
            16w2083: parse_nlt_confirmation_message;
            16w2085: parse_nlt_mod_confirmation_message;
            16w2087: parse_nlt_cxl_confirmation_message;
            16w2088: parse_nlt_mod_reject_message;
            16w2089: parse_nlt_cxl_reject_message;
            16w2124: parse_spread_order_confirmation_message;
            16w2154: parse_sp_order_error_message;
            16w27102: parse_sp_net_order_error_message;
            16w2130: parse_spread_cxl_confirmation_message;
            16w2136: parse_spread_mod_confirmation_message;
            16w2133: parse_spread_mod_reject_message;
            16w2127: parse_spread_cxl_reject_message;
            16w9004: parse_batch_spread_order_cancel_message;
            16w2125: parse_twol_order_confirmation_message;
            16w2126: parse_thrl_order_confirmation_message;
            16w2155: parse_twol_order_error_message;
            16w2156: parse_thrl_order_error_message;
            16w27103: parse_twol_net_order_error_message;
            16w27104: parse_thrl_net_order_error_message;
            16w2131: parse_twol_order_cxl_confirmation_message;
            16w2132: parse_thrl_order_cxl_confirmation_message;
            default: accept;
        }
    }

    state parse_sign_on_out_message {
        packet.extract(hdr.sign_on_out_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_trade_confirmation_message {
        packet.extract(hdr.trade_confirmation_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_trade_modify_confirm_message {
        packet.extract(hdr.trade_modify_confirm_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_trade_modify_reject_message {
