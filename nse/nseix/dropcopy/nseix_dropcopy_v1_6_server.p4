        packet.extract(hdr.batch_spread_order_cancel_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_twol_order_confirmation_message {
        packet.extract(hdr.twol_order_confirmation_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_thrl_order_confirmation_message {
