#include <core.p4>
#include <v1model.p4>

#define MAX_MESSAGES 64
#define FORWARD_PORT 1

header message_header_t {
    bit<16> transaction_code;
    bit<32> log_time;
    bit<16> alpha_char;
    bit<32> trader_id;
    bit<16> error_code;
    bit<64> header_timestamp;
    bit<64> time_stamp_1;
    bit<64> time_stamp_2;
    bit<16> message_length;
}

header system_information_out_message_t {
    bit<16> normal;
    bit<16> oddlot;
    bit<16> spot;
    bit<16> auction;
    bit<16> normal_2;
    bit<16> oddlot_2;
    bit<16> spot_2;
    bit<16> auction_2;
    bit<16> normal_3;
    bit<16> oddlot_3;
    bit<16> spot_3;
    bit<16> auction_3;
    bit<8> update_portfolio;
    bit<8> c_filler;
    bit<32> market_index;
    bit<16> default_settlement_period_normal;
    bit<16> default_settlement_period_spot;
    bit<16> default_settlement_period_auction;
    bit<16> competitor_period;
    bit<16> solicitor_period;
    bit<16> warning_percent;
    bit<16> volume_freeze_percent;
    bit<16> snap_quote_time;
    bit<16> reserved_2;
    bit<32> board_lot_quantity;
    bit<32> tick_size;
    bit<16> maximum_gtc_days;
    bit<1> aon;
    bit<1> minimum_fill;
    bit<1> books_merged;
    bit<13> reserved_113;
    bit<16> disclosed_quantity_percent_allowed;
    bit<32> risk_free_interest_rate;
}

header partial_system_information_message_t {
    bit<16> normal;
    bit<16> oddlot;
    bit<16> spot;
    bit<16> auction;
    bit<16> normal_2;
    bit<16> oddlot_2;
    bit<16> spot_2;
    bit<16> auction_2;
