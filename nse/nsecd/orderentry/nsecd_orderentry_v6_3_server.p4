parser NsecdOrderentryServerParser(packet_in packet, out headers_t hdr, inout metadata_t meta, inout standard_metadata_t standard_metadata) {
    state start {
        packet.extract(hdr.message_header);
        transition select(hdr.message_header.transaction_code) {
            16w1601: parse_system_information_out_message;
            16w7321: parse_partial_system_information_message;
            16w1821: parse_open_order_report_message;
            16w1992: parse_spread_order_log_report_message;
            16w1993: parse_spread_trade_report_message;
            16w2001: parse_board_lot_out_message;
            16w2008: parse_neg_order_to_bl_message;
            16w2041: parse_order_mod_out_message;
            16w2042: parse_order_mod_reject_message;
            16w2071: parse_order_cancel_out_message;
            16w2072: parse_order_cancel_reject_message;
            16w2073: parse_order_confirmation_message;
            16w2074: parse_order_mod_confirmation_message;
            16w2075: parse_order_cancel_confirmation_message;
            16w2076: parse_cancel_neg_order_message;
            16w2170: parse_freeze_to_control_message;
            16w2231: parse_order_error_message;
            16w9002: parse_batch_order_cancel_message;
            16w2101: parse_sp_board_lot_out_message;
            16w2103: parse_twol_board_lot_out_message;
            16w2105: parse_thrl_board_lot_out_message;
            16w2107: parse_sp_order_cancel_out_message;
            16w2119: parse_sp_order_mod_out_message;
            16w2124: parse_sp_order_confirmation_message;
            16w2125: parse_twol_order_confirmation_message;
            16w2126: parse_thrl_order_confirmation_message;
            16w2127: parse_sp_order_cxl_rej_out_message;
            16w2130: parse_sp_order_cxl_confirmation_message;
            16w2131: parse_twol_order_cxl_confirmati_message;
            16w2132: parse_thrl_order_cxl_confirmati_message;
            16w2133: parse_sp_order_mod_rej_out_message;
            16w2136: parse_sp_order_mod_con_out_message;
            16w2155: parse_twol_order_error_message;
            16w2156: parse_thrl_order_error_message;
            16w2212: parse_on_stop_notification_message;
            16w2222: parse_trade_confirmation_message;
            16w2282: parse_trade_cancel_confirm_message;
            16w2286: parse_trade_cancel_reject_message;
            16w2288: parse_trade_modify_reject_message;
            16w2223: parse_trade_error_message;
            16w5441: parse_trade_cancel_out_message;
            16w2287: parse_trade_modify_confirm_message;
            16w2301: parse_sign_on_request_out_message;
            16w5585: parse_sign_off_trader_out_message;
            16w2302: parse_error_response_out_message;
            16w2401: parse_gr_response_message;
            16w4506: parse_giveup_app_confirm_tm_message;
            16w4507: parse_giveup_rej_confirm_tm_message;
            16w5428: parse_user_addr_unlock_confirm_out_message;
            16w5483: parse_user_addr_unlock_approve_out_message;
            16w5484: parse_user_addr_unlock_reject_o_message;
            16w5717: parse_branch_ord_val_limit_upda_message;
            16w5731: parse_user_order_limit_update_out_message;
            16w5733: parse_dealer_limit_update_out_message;
            16w5741: parse_reset_user_password_out_message;
            16w5745: parse_col_user_status_change_out_message;
            16w5772: parse_spd_ord_limit_update_out_message;
            16w7011: parse_header_record_message;
            16w7021: parse_message_record_message;
            16w7031: parse_trailer_record_message;
            16w7307: parse_update_localdb_header_message;
            16w7308: parse_update_localdb_trailer_message;
            16w7325: parse_bcast_asset_mstr_chg_message;
            16w23001: parse_box_sign_on_request_out_message;
            16w20322: parse_box_sign_off_message;
            16w23008: parse_secure_box_registration_re_message;
            16w23009: parse_secure_box_registration_re_message;
            default: accept;
        }
    }

    state parse_system_information_out_message {
        packet.extract(hdr.system_information_out_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_partial_system_information_message {
        packet.extract(hdr.partial_system_information_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_open_order_report_message {
        packet.extract(hdr.open_order_report_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_spread_order_log_report_message {
        packet.extract(hdr.spread_order_log_report_message);
        meta.dispatched = 1;
        transition accept;
    }

    state parse_spread_trade_report_message {
        packet.extract(hdr.spread_trade_report_message);
        meta.dispatched = 1;
        transition accept;
