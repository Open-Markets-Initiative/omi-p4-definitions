control NsecdOrderentryServerVerifyChecksum(inout headers_t hdr, inout metadata_t meta) {
    apply {
    }
}

control NsecdOrderentryServerIngress(inout headers_t hdr, inout metadata_t meta, inout standard_metadata_t standard_metadata) {
    apply {
        if (meta.dispatched == 1) {
            standard_metadata.egress_spec = FORWARD_PORT;
        }
        else {
            mark_to_drop(standard_metadata);
        }
    }
}

control NsecdOrderentryServerEgress(inout headers_t hdr, inout metadata_t meta, inout standard_metadata_t standard_metadata) {
    apply {
    }
}

control NsecdOrderentryServerComputeChecksum(inout headers_t hdr, inout metadata_t meta) {
    apply {
    }
}

control NsecdOrderentryServerDeparser(packet_out packet, in headers_t hdr) {
    apply {
        packet.emit(hdr.message_header);
        packet.emit(hdr.system_information_out_message);
        packet.emit(hdr.partial_system_information_message);
        packet.emit(hdr.open_order_report_message);
        packet.emit(hdr.spread_order_log_report_message);
        packet.emit(hdr.spread_trade_report_message);
        packet.emit(hdr.board_lot_out_message);
        packet.emit(hdr.neg_order_to_bl_message);
        packet.emit(hdr.order_mod_out_message);
        packet.emit(hdr.order_mod_reject_message);
        packet.emit(hdr.order_cancel_out_message);
        packet.emit(hdr.order_cancel_reject_message);
        packet.emit(hdr.order_confirmation_message);
        packet.emit(hdr.order_mod_confirmation_message);
        packet.emit(hdr.order_cancel_confirmation_message);
        packet.emit(hdr.cancel_neg_order_message);
        packet.emit(hdr.freeze_to_control_message);
        packet.emit(hdr.order_error_message);
        packet.emit(hdr.batch_order_cancel_message);
        packet.emit(hdr.sp_board_lot_out_message);
        packet.emit(hdr.twol_board_lot_out_message);
        packet.emit(hdr.thrl_board_lot_out_message);
        packet.emit(hdr.sp_order_cancel_out_message);
        packet.emit(hdr.sp_order_mod_out_message);
        packet.emit(hdr.sp_order_confirmation_message);
        packet.emit(hdr.twol_order_confirmation_message);
        packet.emit(hdr.thrl_order_confirmation_message);
        packet.emit(hdr.sp_order_cxl_rej_out_message);
        packet.emit(hdr.sp_order_cxl_confirmation_message);
        packet.emit(hdr.twol_order_cxl_confirmati_message);
        packet.emit(hdr.thrl_order_cxl_confirmati_message);
        packet.emit(hdr.sp_order_mod_rej_out_message);
        packet.emit(hdr.sp_order_mod_con_out_message);
        packet.emit(hdr.twol_order_error_message);
        packet.emit(hdr.thrl_order_error_message);
        packet.emit(hdr.on_stop_notification_message);
        packet.emit(hdr.trade_confirmation_message);
        packet.emit(hdr.trade_cancel_confirm_message);
        packet.emit(hdr.trade_cancel_reject_message);
        packet.emit(hdr.trade_modify_reject_message);
        packet.emit(hdr.trade_error_message);
        packet.emit(hdr.trade_cancel_out_message);
        packet.emit(hdr.trade_modify_confirm_message);
        packet.emit(hdr.sign_on_request_out_message);
        packet.emit(hdr.sign_off_trader_out_message);
        packet.emit(hdr.error_response_out_message);
        packet.emit(hdr.gr_response_message);
        packet.emit(hdr.giveup_app_confirm_tm_message);
        packet.emit(hdr.giveup_rej_confirm_tm_message);
        packet.emit(hdr.user_addr_unlock_confirm_out_message);
        packet.emit(hdr.user_addr_unlock_approve_out_message);
        packet.emit(hdr.user_addr_unlock_reject_o_message);
        packet.emit(hdr.branch_ord_val_limit_upda_message);
        packet.emit(hdr.user_order_limit_update_out_message);
        packet.emit(hdr.dealer_limit_update_out_message);
        packet.emit(hdr.reset_user_password_out_message);
        packet.emit(hdr.col_user_status_change_out_message);
        packet.emit(hdr.spd_ord_limit_update_out_message);
        packet.emit(hdr.update_localdb_header_message);
        packet.emit(hdr.update_localdb_trailer_message);
        packet.emit(hdr.bcast_asset_mstr_chg_message);
        packet.emit(hdr.box_sign_on_request_out_message);
        packet.emit(hdr.box_sign_off_message);
        packet.emit(hdr.secure_box_registration_re_message);
    }
}

V1Switch(
    NsecdOrderentryServerParser(),
    NsecdOrderentryServerVerifyChecksum(),
    NsecdOrderentryServerIngress(),
    NsecdOrderentryServerEgress(),
    NsecdOrderentryServerComputeChecksum(),
    NsecdOrderentryServerDeparser()
) main;
